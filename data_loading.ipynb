   "source": [
    "# Downloading the kaggle images\n",
    "\n",
    "Downloads the images and data labels and stores them for later use in the training of the models"
   ],
   "id": "427679aeb129abf9"
  },
  {
   "cell_type": "code",
   "id": "initial_id",
   "metadata": {
    "collapsed": true,
    "ExecuteTime": {
     "end_time": "2026-06-12T15:32:43.141663500Z",
     "start_time": "2026-06-12T15:32:40.890909900Z"
    }
   },
   "source": [
    "import kagglehub\n",
    "import os\n",
    "import shutil\n",
    "from pathlib import Path\n",
    "from zipfile import ZipFile\n",
    "\n",
    "#use your own kaggle key to access the galaxyzoo database\n",
    "#Kaggle API token here: os.environ[\"KAGGLE_API_TOKEN\"] = ''\n,
    "cache_path = Path(kagglehub.competition_download(\"galaxy-zoo-the-galaxy-challenge\"))\n",
    "\n",
    "images_path = Path(\"data/images\")\n",
    "labels_path = Path(\"data/labels.csv\")\n",
    "\n",
    "if not images_path.exists():\n",
    "    print(\"extracting image archive\")\n",
    "    with ZipFile(cache_path / \"images_training_rev1.zip\") as images_archive:\n",
    "        images_archive.extractall(images_path.parent)\n",
    "        shutil.move(images_path.parent / \"images_training_rev1\", images_path)\n",
    "\n",
    "if not labels_path.exists():\n",
    "    print(\"extracting label archive\")\n",
    "    with ZipFile(cache_path / \"training_solutions_rev1.zip\") as labels_archive:\n",
    "        labels_archive.extract(\"training_solutions_rev1.csv\", labels_path.parent)\n",
    "        shutil.move(labels_path.parent / \"training_solutions_rev1.csv\", labels_path)"
   ],
